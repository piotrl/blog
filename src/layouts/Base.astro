---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { accentHue } from '../lib/seed';

type Props = Parameters<typeof BaseHead>[0] & { wide?: boolean };

const { wide, ...head } = Astro.props;
---

<!doctype html>
<html lang="en" style={`--hue: ${accentHue}`}>
  <head>
    <BaseHead {...head} />
  </head>
  <body class:list={{ wide }}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
