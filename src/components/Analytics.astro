---
import { UMAMI_WEBSITE_ID } from 'astro:env/client';

// Cookieless Umami Cloud. No website ID → no script. data-domains keeps deploy previews out of the stats.
const SCRIPT_URL = 'https://cloud.umami.is/script.js';
const domain = new URL(Astro.site!).hostname;
---

{UMAMI_WEBSITE_ID && <script is:inline defer src={SCRIPT_URL} data-website-id={UMAMI_WEBSITE_ID} data-domains={domain} />}
