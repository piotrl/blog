---
import { type Post, postUrl } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map(post => (
      <li>
        <time datetime={post.data.date.toISOString()}>{post.data.date.getFullYear()}</time>
        <div>
          <a href={postUrl(post)}>{post.data.title}</a>
          <p>{post.data.description}</p>
        </div>
      </li>
    ))
  }
</ul>
