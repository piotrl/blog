---
const links = [
  { label: 'About', url: '/about/' },
  { label: 'Writing', url: '/page/1/' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/">Piotr Lewandowski</a>
  <nav>
    {links.map(link => <a href={link.url} aria-current={current === link.url ? 'page' : undefined}>{link.label}</a>)}
  </nav>
</header>
