---
import SocialLinks from '../components/SocialLinks.astro';
import Topology from '../components/Topology.astro';
import {
  AUTHOR_FULL_NAME,
  CAREER,
  CAREER_NOTE,
  CAREER_SINCE,
  CONTACT_EMAIL,
  EMPLOYER,
  FOCUS_AREAS,
  JOB_TITLE,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SOCIAL_LINKS,
} from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';
import { person, withContext } from '../lib/schema';

const posts = await getPosts();
const years = posts.map(post => post.data.date.getFullYear());
const linkedIn = SOCIAL_LINKS.find(link => link.label === 'LinkedIn')!;
---

<Base
  title={`${SITE_TITLE} – ${JOB_TITLE}`}
  description={SITE_DESCRIPTION}
  jsonLd={withContext(person(Astro.site!))}
  wide
>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{AUTHOR_FULL_NAME} · {JOB_TITLE} · {EMPLOYER.name} · Gdańsk</p>
      <h1>Hi, I’m Piotr.</h1>
      <p class="lede">
        I like untangling large web apps: how they’re built, shipped and kept healthy once real users show up. Mostly
        frontend architecture, observability, and automating anything I’ve had to do twice.
      </p>
      <p class="hero-links">
        <a href="/about/">About me</a>
        <a href={linkedIn.url}>LinkedIn ↗</a>
      </p>
    </div>
    <Topology sources={['logs', 'metrics', 'traces']} note="that’s me!" />
  </section>

  <section class="section">
    <h2>What I work on</h2>
    <ol class="focus">
      {
        FOCUS_AREAS.map(area => (
          <li>
            <h3>{area.title}</h3>
            <p>{area.summary}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <h2>Path</h2>
    <ol class="path">
      {
        CAREER.map(step => (
          <li>
            <strong>{step.stage}</strong>
            <span>{step.detail}</span>
          </li>
        ))
      }
    </ol>
    <p class="note">
      Since {CAREER_SINCE}. {CAREER_NOTE} <a href={linkedIn.url}>Full history on LinkedIn</a></p>
  </section>

  <section class="section split">
    <div>
      <h2>Writing</h2>
      <p>
        {posts.length} articles from {Math.min(...years)}–{Math.max(...years)} on Angular, TypeScript and testing.{' '}
        <a href="/page/1/">Read the archive</a>
      </p>
    </div>
    <div>
      <h2>Contact</h2>
      <p>The best way to reach me is LinkedIn, or <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
      <SocialLinks />
    </div>
  </section>
</Base>
