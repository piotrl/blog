---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import TagList from '../components/TagList.astro';
import { ABOUT, AUTHOR_FULL_NAME } from '../consts';
import Base from '../layouts/Base.astro';
import { formatDate, getPosts, type Post, postUrl, relatedPosts } from '../lib/posts';
import { person, withContext } from '../lib/schema';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { title, description, date, cover, tags } = post.data;
const { Content } = await render(post);
// Older posts get a short note so readers know the tooling may have moved on.
const isArchived = new Date().getFullYear() - date.getFullYear() >= 3;
const url = new URL(postUrl(post), Astro.site).href;

const jsonLd = withContext({
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  url,
  mainEntityOfPage: url,
  keywords: tags,
  author: person(Astro.site!),
  ...(cover && { image: new URL(cover.src, Astro.site).href }),
});
---

<Base {title} {description} image={cover} type="article" publishedTime={date} {jsonLd}>
  <article class="post">
    <header>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <h1>{title}</h1>
      {isArchived && <p class="archive-note">Written in {date.getFullYear()}. Kept for reference, so some details may be dated.</p>}
    </header>
    {cover && <Image src={cover} width={720} alt="" class="cover" loading="eager" fetchpriority="high" />}
    <div class="prose">
      <Content />
    </div>
    <footer>
      <TagList {tags} />
      <aside class="author">
        <h2>Author</h2>
        <p>Blog by <a href="/about/">{AUTHOR_FULL_NAME}</a><br />{ABOUT}</p>
      </aside>
    </footer>
  </article>

  {
    related.length > 0 && (
      <section class="related">
        <h2>Related Posts</h2>
        <ul>
          {related.map(p => <li><a href={postUrl(p)}>{p.data.title}</a></li>)}
        </ul>
      </section>
    )
  }
</Base>
