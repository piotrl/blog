---
import type { GetStaticPaths, Page } from 'astro';
import PostList from '../../components/PostList.astro';
import { POSTS_PER_PAGE, SITE_DESCRIPTION } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getPosts, type Post } from '../../lib/posts';

export const getStaticPaths = (async ({ paginate }) =>
  paginate(await getPosts(), { pageSize: POSTS_PER_PAGE })) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
---

<Base title="Writing" description={SITE_DESCRIPTION}>
  <header class="page-header">
    <h1>Writing</h1>
  </header>
  <PostList posts={page.data} />
  {
    page.lastPage > 1 && (
      <nav class="pagination">
        {page.url.prev && <a href={page.url.prev}>← Newer</a>}
        <span>
          {page.currentPage} / {page.lastPage}
        </span>
        {page.url.next && <a href={page.url.next}>Older →</a>}
      </nav>
    )
  }
</Base>
