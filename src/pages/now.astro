---
import Base from '../layouts/Base.astro';

// Bump on every edit: a /now page is only useful while it's current.
const updated = new Date('2026-10-31');
---

<Base title="Now" description="What Piotr Lewandowski is focused on right now.">
  <article class="post">
    <header>
      <h1>What I’m doing now</h1>
      <p>
        Updated <time datetime={updated.toISOString().slice(0, 10)}>{updated.toISOString().slice(0, 10)}</time>, from
        Gdańsk. A <a href="https://nownownow.com/about">/now page</a>.
      </p>
    </header>
    <div class="prose">
      <h2>Work</h2>
      <p>TODO(Piotr): one or two sentences on your current focus as Product Architect.</p>

      <h2>Writing</h2>
      <p>
        Relaunching this blog. Next up: TODO(Piotr): first post topic and rough date.
      </p>

      <h2>Outside work</h2>
      <p>TODO(Piotr): optional, only what you’re happy to share publicly.</p>
    </div>
  </article>
</Base>
